rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo el acceso a datos pasa por la API (src/app/api), que usa Firebase
    // Admin y verifica el usuario en cada pedido. Firebase Admin no está sujeto
    // a estas reglas, así que desde el navegador no se puede leer ni escribir nada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
