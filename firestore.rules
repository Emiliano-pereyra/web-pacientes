service cloud.firestore {
  match /databases/{database}/documents {
    
    match /pacientes/lista/nombresPacientes/{pacienteId} {
      
      // Lectura: autenticado
      allow read: if request.auth != null;
      
      // Creación: requiere nombreCompleto
      allow create: if request.auth != null 
                    && request.resource.data.nombreCompleto is string;
      
      // Actualización: solo autenticado (permite actualizar galeriaFotos, urlFoto, etc.)
      allow update: if request.auth != null;
      
      // Eliminar documento paciente: DESHABILITADO (seguridad)
      allow delete: if false;
    }
    
    // Denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
